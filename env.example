# =============================================================================
# LaraAI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   php artisan key:generate
#
# Required before first run:
#   - Generate APP_KEY (done automatically by key:generate)
#   - Set OPENROUTER_API_KEY for production models and vision features
#   - All other defaults work out of the box with Docker
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=LaraAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# Defaults match the Docker Compose MySQL container.
# Change only if connecting to an external database.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laraai
DB_USERNAME=root
DB_PASSWORD=root

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Queue & Cache
# Both use Redis. Defaults match the Docker Compose Redis container.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# Defaults use log driver - emails are written to Laravel logs, not sent.
# Switch to smtp + real credentials for production.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email address for Horizon queue alerts and dashboard access
HORIZON_ALERT_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# AI - Providers
# Default provider is Ollama (local, free, no key needed).
# Set OPENROUTER_API_KEY to enable production models, vision, and fallback.
# -----------------------------------------------------------------------------

# Prism PHP internal defaults (used as base provider config)
PRISM_DEFAULT_PROVIDER=ollama
PRISM_DEFAULT_MODEL=llama3.2:1b

# Ollama local instance - matches Docker Compose service name
OLLAMA_URL=http://ollama:11434

# OpenRouter - required for production, vision (Gemini), and fallback chain
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# -----------------------------------------------------------------------------
# AI - Models
# Configure which model handles each use case.
# Smaller models (llama3.2:1b) are faster; larger (llama3.1:8b) more capable.
# Vision always routes to OpenRouter - Ollama has no vision support.
# -----------------------------------------------------------------------------
AI_TEXT_MODEL=llama3.2:1b
AI_TOOLS_MODEL=llama3.1:8b
AI_EMBEDDINGS_MODEL=nomic-embed-text
AI_AGENT_MODEL=llama3.1:8b
AI_VISION_MODEL=google/gemini-flash-1.5

# -----------------------------------------------------------------------------
# AI - Provider Strategy
# -----------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=ollama
AI_PRODUCTION_PROVIDER=openrouter

# Fallback chain: primary fails → secondary tried automatically
AI_FALLBACK_PRIMARY_MODEL=openrouter/free
AI_FALLBACK_SECONDARY_MODEL=llama3.2:1b

# -----------------------------------------------------------------------------
# AI - Performance & Limits
# -----------------------------------------------------------------------------
# How long to cache identical AI responses (seconds). 0 = no cache.
AI_CACHE_TTL=3600

# Max documents returned by semantic search
AI_SEARCH_LIMIT=5

# Retry attempts and delay between them (milliseconds) on AI call failure
AI_RETRY_TIMES=3
AI_RETRY_SLEEP_MS=1000

# Default fallback system prompt when no DB prompt version exists
AI_DEFAULT_SYSTEM_PROMPT="You are a helpful assistant."

# -----------------------------------------------------------------------------
# AI - Cost Alerts
# CostAlertListener fires a Slack alert when a single AI call exceeds this.
# Set to 0 to disable alerts. Increase for production paid models.
# -----------------------------------------------------------------------------
AI_COST_ALERT_THRESHOLD=0.01

# Slack webhook URL for cost alerts
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_ALERTS_WEBHOOK_URL=your-slack-webhook-url-here

# -----------------------------------------------------------------------------
# Telescope
# Disable in production or restrict access via TelescopeServiceProvider.
# -----------------------------------------------------------------------------
TELESCOPE_ENABLED=true

# -----------------------------------------------------------------------------
# Sentry
# Production error tracking. Leave blank to disable.
# Get your DSN at: https://sentry.io
# -----------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# AWS (optional - not used by default)
# Only needed if switching FILESYSTEM_DISK to s3.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
